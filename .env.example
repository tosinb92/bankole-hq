# Free-tier PostgreSQL connection string (for example Supabase or Neon). Never commit the real value.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/bankole_hq?schema=public"
# Set only in Vercel (or a local server-only .env file). Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=""
# Server-side Google OAuth only. Do not expose any of these in NEXT_PUBLIC_* variables.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
GOOGLE_REFRESH_TOKEN=""
# Explicit folder IDs are optional. Without them the app does not crawl Drive.
BA_DRIVE_FOLDER_ID=""
SKILLS_DRIVE_FOLDER_ID="1nUD4CfUP5lBVMH5Gwwy6WQpRPfYTIT4e"

# FireComplianceUK outbound email — server-side only.
FIRE_SMTP_HOST="smtp0001.neo.space"
FIRE_SMTP_PORT="465"
FIRE_SMTP_USER="contact@firecomplianceuk.co.uk"
FIRE_SMTP_PASSWORD=""
# Private approval token required by /api/fire/outreach/send.
