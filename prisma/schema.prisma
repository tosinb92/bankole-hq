generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  OWNER
  VENTURE_ADMIN
  SALES
  OPERATIONS
  FINANCE
  ASSOCIATE
  VIEWER
}
enum LeadStage {
  NEW_LEAD
  REQUIREMENTS
  VENUE_SOURCING
  PRICING
  CALL
  QUOTE
  FOLLOW_UP
  DEPOSIT
  VENUE_SECURED
  CONFIRMED
  EVENT
  WON
  LOST
}
enum VenuePriceStatus {
  ESTIMATED
  HISTORICAL
  VERIFIED
  BOOKED
}
enum AiJobStatus {
  QUEUED
  RUNNING
  NEEDS_APPROVAL
  COMPLETED
  FAILED
  BLOCKED
}
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}
enum ActionLane {
  AI_CAN_HANDLE
  NEEDS_APPROVAL
  NEEDS_ME
  WAITING_EXTERNAL
}
enum ActionKind {
  ANALYSE_EMAIL
  ANALYSE_THREAD
  DRAFT_REPLY
  DRAFT_FOLLOW_UP
  PREPARE_MEETING_BRIEF
  ANALYSE_AGREEMENT
  CALCULATE_ENTITLEMENT
  REVIEW_DOCUMENTS
  CHASE_COMMITMENT
  FIND_PROFESSIONAL
  PREPARE_QUOTE
  GENERATE_CONTENT
  RUN_SKILL
}
enum CommunicationStatus {
  DRAFT
  NEEDS_APPROVAL
  APPROVED
  SENT
  FAILED
}
enum EvidenceStatus {
  PROJECTED
  CONTRACTUALLY_EVIDENCED
  EARNED
  INVOICED
  PAID
}
enum ProfessionalVerification {
  UNREVIEWED
  POTENTIAL_MATCH
  CONTACTED
  CAPABILITY_CONFIRMED
  CREDENTIALS_VERIFIED
  RATE_CONFIRMED
  AVAILABLE
  APPROVED_SUPPLIER
  PREVIOUSLY_USED
}
enum SkillExecutionStatus {
  QUEUED
  RUNNING
  NEEDS_APPROVAL
  COMPLETED
  FAILED
  BLOCKED
}

model User {
  id String @id @default(cuid())
  email String @unique
  name String?
  role SystemRole @default(VIEWER)
  createdAt DateTime @default(now())
  memberships VentureMembership[]
  dealAssignments DealAssignment[]
  tasks Task[]
}
model Venture {
  id String @id @default(cuid())
  name String @unique
  sector String?
  status String @default("Active")
  createdAt DateTime @default(now())
  memberships VentureMembership[]
  contacts Contact[]
  leads Lead[]
  deals Deal[]
  tasks Task[]
  aiJobs AiJob[]
  revenue RevenueEntry[]
  documents Document[]
  pricingRules PricingRule[]
  actions Action[]
  communications Communication[]
  skillExecutions SkillExecution[]
  intelligenceEvidence IntelligenceEvidence[]
  intelligenceSkillRuns IntelligenceSkillRun[]
  competitors Competitor[]
  intelligenceOpportunities IntelligenceOpportunity[]
  brandSettings VentureBrandSettings?
}
model VentureMembership {
  id String @id @default(cuid())
  userId String
  ventureId String
  role SystemRole
  canViewFinancials Boolean @default(false)
  canViewCosts Boolean @default(false)
  canViewMargins Boolean @default(false)
  canViewCommissions Boolean @default(false)
  canManageMembers Boolean @default(false)
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  venture Venture @relation(fields:[ventureId], references:[id], onDelete:Cascade)
  @@unique([userId, ventureId])
}
model Deal {
  id String @id @default(cuid())
  ventureId String
  title String
  stage String
  value Decimal? @db.Decimal(12,2)
  sensitiveFinancials Boolean @default(true)
  venture Venture @relation(fields:[ventureId], references:[id], onDelete:Cascade)
  assignments DealAssignment[]
  actions Action[]
  economics DealEconomics?
  commitments DealCommitment[]
  communications Communication[]
  skillExecutions SkillExecution[]
  createdAt DateTime @default(now())
}
model DealAssignment {
  id String @id @default(cuid())
  userId String
  dealId String
  canViewFinancials Boolean @default(false)
  canEdit Boolean @default(true)
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  deal Deal @relation(fields:[dealId], references:[id], onDelete:Cascade)
  @@unique([userId, dealId])
}
model Organisation {
  id String @id @default(cuid())
  name String
  type String?
  website String?
  contacts Contact[]
  createdAt DateTime @default(now())
}
model Contact {
  id String @id @default(cuid())
  name String
  email String?
  phone String?
  role String?
  ventureId String?
  organisationId String?
  venture Venture? @relation(fields:[ventureId], references:[id])
  organisation Organisation? @relation(fields:[organisationId], references:[id])
  actions Action[]
  createdAt DateTime @default(now())
}
model Lead {
  id String @id @default(cuid())
  ventureId String
  customerName String
  email String?
  phone String?
  requestedLocation String?
  postcode String?
  requirements Json?
  stage LeadStage @default(NEW_LEAD)
  estimatedValue Decimal? @db.Decimal(12,2)
  assignedToId String?
  venueId String?
  venue Venue? @relation(fields:[venueId],references:[id])
  venture Venture @relation(fields:[ventureId],references:[id], onDelete:Cascade)
  calls Call[]
  quotes Quote[]
  tasks Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Venue {
  id String @id @default(cuid())
  name String
  address String?
  postcode String?
  latitude Float?
  longitude Float?
  facilities Json?
  permittedActivities Json?
  capacity Int?
  dimensions String?
  price Decimal? @db.Decimal(12,2)
  pricingUnit String?
  priceStatus VenuePriceStatus @default(ESTIMATED)
  sourceUrl String?
  priceVerifiedAt DateTime?
  availabilityStatus String?
  contactName String?
  contactEmail String?
  contactPhone String?
  bookingMethod String?
  depositRequirement String?
  leads Lead[]
  bookings Booking[]
  createdAt DateTime @default(now())
}
model PricingRule {
  id String @id @default(cuid())
  ventureId String
  name String
  activity String
  customerType String
  durationMinutes Int?
  groupMin Int?
  groupMax Int?
  basePriceMin Decimal @db.Decimal(12,2)
  basePriceMax Decimal @db.Decimal(12,2)
  staffingCost Decimal @default(0) @db.Decimal(12,2)
  equipmentCost Decimal @default(0) @db.Decimal(12,2)
  travelCostPerMile Decimal @default(0) @db.Decimal(12,2)
  minMarginPercent Decimal @default(0) @db.Decimal(5,2)
  extras Json?
  active Boolean @default(true)
  venture Venture @relation(fields:[ventureId],references:[id], onDelete:Cascade)
  createdAt DateTime @default(now())
  @@index([ventureId,activity])
}
model Quote {
  id String @id @default(cuid())
  leadId String
  customerPrice Decimal @db.Decimal(12,2)
  directCosts Decimal @db.Decimal(12,2)
  grossProfit Decimal @db.Decimal(12,2)
  status String @default("Draft")
  lead Lead @relation(fields:[leadId],references:[id], onDelete:Cascade)
  createdAt DateTime @default(now())
}
model Call {
  id String @id @default(cuid())
  leadId String
  outcome String
  notes String?
  scheduledAt DateTime?
  completedAt DateTime?
  providerCallId String?
  lead Lead @relation(fields:[leadId],references:[id], onDelete:Cascade)
  createdAt DateTime @default(now())
}
model Booking {
  id String @id @default(cuid())
  ventureId String
  venueId String?
  status String
  eventAt DateTime?
  depositAmount Decimal? @db.Decimal(12,2)
  venue Venue? @relation(fields:[venueId],references:[id])
  createdAt DateTime @default(now())
}
model Task {
  id String @id @default(cuid())
  title String
  status TaskStatus @default(TODO)
  priority Int @default(3)
  dueAt DateTime?
  ventureId String?
  leadId String?
  assigneeId String?
  venture Venture? @relation(fields:[ventureId],references:[id], onDelete:Cascade)
  lead Lead? @relation(fields:[leadId],references:[id], onDelete:Cascade)
  assignee User? @relation(fields:[assigneeId],references:[id])
  createdAt DateTime @default(now())
}
model AiJob {
  id String @id @default(cuid())
  ventureId String
  skillId String?
  title String
  input Json?
  output Json?
  status AiJobStatus @default(QUEUED)
  requiresApproval Boolean @default(false)
  approvedAt DateTime?
  startedAt DateTime?
  completedAt DateTime?
  error String?
  integrationKey String?
  venture Venture @relation(fields:[ventureId],references:[id], onDelete:Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Skill {
  id String @id @default(cuid())
  name String @unique
  description String?
  sourceUrl String?
  sourceFileId String?
  sourceFile String?
  sourceVersion String?
  instructions String?
  allowedVentureIds Json?
  requiredInputs Json?
  integrationKey String?
  active Boolean @default(false)
  executions SkillExecution[]
  intelligenceRuns IntelligenceSkillRun[]
  sources SkillSource[]
  createdAt DateTime @default(now())
}
model SkillSource {
  id String @id @default(cuid())
  skillId String
  driveFileId String
  zipFileName String
  sourcePath String
  sourceUrl String
  sourceVersion String?
  instructions String
  importedAt DateTime @default(now())
  skill Skill @relation(fields:[skillId], references:[id], onDelete:Cascade)
  @@unique([skillId, driveFileId, sourcePath])
  @@index([driveFileId])
}
model Document {
  id String @id @default(cuid())
  ventureId String?
  title String
  storageKey String
  type String?
  venture Venture? @relation(fields:[ventureId],references:[id], onDelete:Cascade)
  createdAt DateTime @default(now())
}
model RevenueEntry {
  id String @id @default(cuid())
  ventureId String
  amount Decimal @db.Decimal(12,2)
  type String
  category String?
  occurredAt DateTime
  notes String?
  venture Venture @relation(fields:[ventureId],references:[id], onDelete:Cascade)
  createdAt DateTime @default(now())
}
model Action {
  id String @id @default(cuid())
  ventureId String
  dealId String?
  contactId String?
  title String
  kind ActionKind
  lane ActionLane
  urgency Int @default(3)
  monetaryRelevance Decimal? @db.Decimal(12,2)
  recommendation String
  executionState String @default("Ready")
  outcome String?
  requiresIntegration String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  venture Venture @relation(fields:[ventureId], references:[id], onDelete:Cascade)
  deal Deal? @relation(fields:[dealId], references:[id], onDelete:Cascade)
  contact Contact? @relation(fields:[contactId], references:[id], onDelete:SetNull)
  @@index([ventureId, lane])
  @@index([dealId])
}
model DealEconomics {
  id String @id @default(cuid())
  dealId String
  transactionValue Decimal? @db.Decimal(16,2)
  feeBasis String
  fixedFee Decimal? @db.Decimal(12,2)
  percentageFee Decimal? @db.Decimal(7,4)
  introductionFee Decimal? @db.Decimal(12,2)
  successFee Decimal? @db.Decimal(12,2)
  milestoneFees Json?
  projectedEntitlement Decimal @default(0) @db.Decimal(12,2)
  evidencedEntitlement Decimal @default(0) @db.Decimal(12,2)
  earnedAmount Decimal @default(0) @db.Decimal(12,2)
  invoicedAmount Decimal @default(0) @db.Decimal(12,2)
  paidAmount Decimal @default(0) @db.Decimal(12,2)
  expectedPaymentDate DateTime?
  responsibleCounterparty String?
  evidenceSource String?
  evidenceStatus EvidenceStatus @default(PROJECTED)
  createdAt DateTime @default(now())
  deal Deal @relation(fields:[dealId], references:[id], onDelete:Cascade)
  @@unique([dealId])
}
model DealCommitment {
  id String @id @default(cuid())
  dealId String
  promisedBy String
  commitment String
  dueAt DateTime?
  evidenceSource String?
  linkedMilestone String?
  status String @default("Open")
  recommendedFollowUp String?
  createdAt DateTime @default(now())
  deal Deal @relation(fields:[dealId], references:[id], onDelete:Cascade)
  @@index([dealId, dueAt])
}
model Communication {
  id String @id @default(cuid())
  ventureId String
  dealId String?
  subject String
  body String?
  status CommunicationStatus @default(DRAFT)
  providerMessageId String?
  createdAt DateTime @default(now())
  venture Venture @relation(fields:[ventureId], references:[id], onDelete:Cascade)
  deal Deal? @relation(fields:[dealId], references:[id], onDelete:Cascade)
  @@index([ventureId, status])
}
model Professional {
  id String @id @default(cuid())
  name String
  company String?
  role String?
  email String?
  phone String?
  linkedinUrl String?
  website String?
  geography String?
  serviceArea String?
  capabilities Json?
  qualifications Json?
  insuranceDetails String?
  rates Json?
  availability String?
  capacity String?
  previousJobs Json?
  qualityNotes String?
  source String?
  lastVerifiedAt DateTime?
  verification ProfessionalVerification @default(UNREVIEWED)
  imports ProfessionalImport[]
  createdAt DateTime @default(now())
}
model ProfessionalImport {
  id String @id @default(cuid())
  sourceSpreadsheetId String
  sourceTab String
  sourceRow Int?
  rawRecord Json
  professionalId String?
  classification String?
  dedupeKey String
  importStatus String @default("Pending")
  createdAt DateTime @default(now())
  professional Professional? @relation(fields:[professionalId], references:[id], onDelete:SetNull)
  @@unique([sourceSpreadsheetId, sourceTab, sourceRow])
  @@index([dedupeKey])
}
model SkillExecution {
  id String @id @default(cuid())
  skillId String
  ventureId String
  dealId String?
  projectRef String?
  sourceFile String?
  sourceVersion String?
  requiredInputs Json?
  input Json?
  output Json?
  status SkillExecutionStatus @default(QUEUED)
  approvalState String @default("Not required")
  downstreamActionId String?
  createdAt DateTime @default(now())
  completedAt DateTime?
  skill Skill @relation(fields:[skillId], references:[id], onDelete:Restrict)
  venture Venture @relation(fields:[ventureId], references:[id], onDelete:Cascade)
  deal Deal? @relation(fields:[dealId], references:[id], onDelete:Cascade)
  @@index([ventureId, status])
}
model IntelligenceEvidence {
  id String @id @default(cuid())
  ventureId String
  competitorId String?
  competitorName String
  accountName String?
  platform String
  distribution String @default("ORGANIC")
  contentType String?
  mediaUrl String?
  title String
  sourceUrl String?
  observedAt DateTime?
  capturedAt DateTime @default(now())
  contentText String?
  hook String?
  offer String?
  cta String?
  audienceAngle String?
  format String?
  durationSeconds Int?
  landingPageUrl String?
  firstSeenAt DateTime?
  lastSeenAt DateTime?
  activityStatus String?
  observableSignals Json?
  metrics Json?
  provenance String
  venture Venture @relation(fields:[ventureId], references:[id], onDelete:Cascade)
  competitor Competitor? @relation(fields:[competitorId], references:[id], onDelete:SetNull)
  runLinks IntelligenceSkillRunEvidence[]
  opportunities IntelligenceOpportunity[]
  @@index([ventureId, competitorName, platform])
  @@index([competitorId, capturedAt])
}
model Competitor {
  id String @id @default(cuid())
  ventureId String
  name String
  websiteUrl String?
  instagramUrl String?
  facebookUrl String?
  youtubeChannelUrl String?
  metaAdLibraryUrl String?
  active Boolean @default(true)
  lastCollectedAt DateTime?
  lastCollectionError String?
  createdAt DateTime @default(now())
  venture Venture @relation(fields:[ventureId], references:[id], onDelete:Cascade)
  evidence IntelligenceEvidence[]
  @@unique([ventureId, name])
  @@index([ventureId, active])
}
model IntelligenceOpportunity {
  id String @id @default(cuid())
  ventureId String
  evidenceId String?
  skillRunId String?
  title String
  brief String
  status String @default("Needs Approval")
  createdAt DateTime @default(now())
  venture Venture @relation(fields:[ventureId], references:[id], onDelete:Cascade)
  evidence IntelligenceEvidence? @relation(fields:[evidenceId], references:[id], onDelete:SetNull)
  @@index([ventureId, status])
}
model IntelligenceSkillRun {
  id String @id @default(cuid())
  ventureId String
  skillId String
  scope Json?
  input Json
  output Json?
  status SkillExecutionStatus @default(QUEUED)
  error String?
  createdAt DateTime @default(now())
  completedAt DateTime?
  venture Venture @relation(fields:[ventureId], references:[id], onDelete:Cascade)
  skill Skill @relation(fields:[skillId], references:[id], onDelete:Restrict)
  evidence IntelligenceSkillRunEvidence[]
  @@index([ventureId, status])
}
model IntelligenceSkillRunEvidence {
  runId String
  evidenceId String
  run IntelligenceSkillRun @relation(fields:[runId], references:[id], onDelete:Cascade)
  evidence IntelligenceEvidence @relation(fields:[evidenceId], references:[id], onDelete:Cascade)
  @@id([runId, evidenceId])
}
model VentureBrandSettings {
  id String @id @default(cuid())
  ventureId String @unique
  logoUrl String?
  colours Json?
  typographyPreference String?
  imagery Json?
  headerLabel String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  venture Venture @relation(fields:[ventureId], references:[id], onDelete:Cascade)
}
